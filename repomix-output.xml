  const [complaintForm, setComplaintForm] = useState<{
    customerName: string;
    loadNumber: string;
    category: CustomerComplaintDetails["category"];
    substantiationStatus: CustomerComplaintDetails["substantiationStatus"];
    reviewNotes: string;
