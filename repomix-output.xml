                        <span className="font-mono text-[10px] text-muted-foreground">
                          {finding.matchedRecordId}
                        </span>
                      )}
                    </div>

                    <p className="mt-2 text-xs leading-5 text-muted-foreground">
                      {finding.message}
                    </p>
