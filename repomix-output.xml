            <section>
              <Label className="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
                Policy
              </Label>

              <div className="mt-3 grid gap-4">
                <LinkedEntityField
                  label="Insurance Company"
                  value={
                    record.insurerName
