            </div>

            <div className="space-y-2">
              <Label className="font-medium text-primary">
                Operating Region *
              </Label>

              {/*
                CRITICAL CONTRACT:
                Do not rename/remove this field casually.
              */}
              <input
                type="hidden"
                name="opRegion"
                value={opRegion}
              />

              <Select
