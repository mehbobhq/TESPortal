function Profile({master,rel,address,licence,edit,draft,setDraft,onSave,recordId}:{master:DriverMaster;rel:CompanyDriverRelationship;address:any;licence:any;edit:boolean;draft:Record<string,string>;setDraft:(x:any)=>void;onSave:()=>void;recordId:string}){const set=(k:string,v:string)=>setDraft((d:any)=>({...d,[k]:v}));if(edit)return <Card><CardHeader><CardTitle>Edit Driver Profile</CardTitle></CardHeader><CardContent className="space-y-6"><Grid><F l="Legal First Name *" v={draft.first} s={v=>set("first",v)}/><F l="Middle Name" v={draft.middle} s={v=>set("middle",v)}/><F l="Legal Last Name *" v={draft.last} s={v=>set("last",v)}/><F l="Preferred Name" v={draft.preferred} s={v=>set("preferred",v)}/><F l="Date of Birth *" t="date" v={draft.dob} s={v=>set("dob",v)}/><S l="Record Type" v={draft.recordType} s={v=>set("recordType",v)} o={RT}/><S l="Operating Region" v={draft.region} s={v=>set("region",v)} o={RG}/><S l="Driver Status" v={draft.status} s={v=>set("status",v)} o={ST}/><F l="Relationship Start" t="date" v={draft.start} s={v=>set("start",v)}/><F l="Relationship End" t="date" v={draft.end} s={v=>set("end",v)}/><F l="Address" v={draft.address1} s={v=>set("address1",v)}/><F l="Address Line 2" v={draft.address2} s={v=>set("address2",v)}/><F l="City" v={draft.city} s={v=>set("city",v)}/><S l="Country" v={draft.country} s={v=>set("country",v)} o={["Canada","United States"]}/><F l="State / Province" v={draft.state} s={v=>set("state",v)}/><F l="Postal / ZIP" v={draft.postal} s={v=>set("postal",v)}/><F l="Address Effective From" t="date" v={draft.addressEffective} s={v=>set("addressEffective",v)}/></Grid><div className="flex justify-end"><Button onClick={onSave}>Save</Button></div></CardContent></Card>
 return <div className="grid gap-5 lg:grid-cols-2"><Card><CardHeader><CardTitle>General Information</CardTitle></CardHeader><CardContent className="grid gap-5 sm:grid-cols-2"><ReadOnlyField label="Company Driver Record ID" value={recordId}/><ReadOnlyField label="Driver Master ID" value={master.id}/><ReadOnlyField label="Legal Name" value={fullLegalName(master)}/><ReadOnlyField label="Preferred Name" value={master.identity.preferredName||"—"}/><ReadOnlyField label="Date of Birth" value={fmt(master.identity.dateOfBirth)}/><ReadOnlyField label="Age" value={String(calculateAge(master.identity.dateOfBirth)??"—")}/><ReadOnlyField label="Record Type" value={rel.recordType}/><ReadOnlyField label="Operating Region" value={rel.operatingRegion}/><ReadOnlyField label="Driver Status" value={rel.driverStatus}/><ReadOnlyField label="Relationship Start" value={fmt(rel.startDate)}/></CardContent></Card><Card><CardHeader><CardTitle>Current Address & Licence Summary</CardTitle></CardHeader><CardContent className="grid gap-5 sm:grid-cols-2"><ReadOnlyField label="Address" value={address?[address.addressLine1,address.addressLine2,address.city,address.stateProvince,address.postalZip,address.country].filter(Boolean).join(", "):"—"}/><ReadOnlyField label="Address Effective" value={fmt(address?.effectiveFrom)}/><ReadOnlyField label="Licence" value={licence?`${licence.jurisdiction} · ${licence.class||"Class —"}`:"—"}/><ReadOnlyField label="Licence Number" value={licence?.licenceNumberRaw||"—"}/><ReadOnlyField label="Licence Expiry" value={fmt(licence?.expiryDate)}/><ReadOnlyField label="Licence Verification" value={licence?.verificationState||"Not Reviewed"}/></CardContent></Card><Card className="lg:col-span-2"><CardHeader><CardTitle>History</CardTitle></CardHeader><CardContent><History title="Driver Status" rows={rel.statusHistory.map(x=>[x.statusValue,fmt(x.effectiveFrom),fmt(x.effectiveTo||undefined),x.reason||"—"])}/><History title="Address History" rows={master.addressHistory.map(x=>[[x.city,x.stateProvince,x.country].filter(Boolean).join(", "),fmt(x.effectiveFrom),fmt(x.effectiveTo||undefined),x.status])}/>{master.jurisdictionReviews.length>0&&<History title="Identity / Jurisdiction Review" rows={master.jurisdictionReviews.map(x=>[x.status,x.reason,x.explanation||"—",x.expectedResolutionDate?fmt(x.expectedResolutionDate):"—"])}/>}</CardContent></Card></div>}

function Qualifications({master,rel,companyId,qualifications,experience,onRefresh,openModal}:{master:DriverMaster;rel:CompanyDriverRelationship;companyId:string;qualifications:any[];experience:any[];onRefresh:()=>void;openModal:(x:string)=>void}){const lic=currentLicence(master);return <div className="space-y-5"><Card><CardHeader><div className="flex justify-between"><div><CardTitle>Driver Licence</CardTitle><p className="mt-1 text-sm text-muted-foreground">Permanent licence history; source facts and reviewed values remain distinct.</p></div><Button onClick={()=>openModal("licence")}><Plus className="mr-2 size-4"/>Add Licence Record</Button></div></CardHeader><CardContent><div className="grid gap-5 md:grid-cols-4"><ReadOnlyField label="Issuing Jurisdiction" value={lic?.jurisdiction||"—"}/><ReadOnlyField label="Licence Number" value={lic?.licenceNumberRaw||"—"}/><ReadOnlyField label="Class" value={lic?.class||"—"}/><ReadOnlyField label="Expiry" value={fmt(lic?.expiryDate)}/><ReadOnlyField label="Endorsements" value={lic?.endorsements?.join(", ")||"—"}/><ReadOnlyField label="Restrictions" value={lic?.restrictions?.join(", ")||"—"}/><ReadOnlyField label="Air Brake" value={lic?.airBrake||"—"}/><ReadOnlyField label="Verification" value={lic?.verificationState||"Not Reviewed"}/></div><History title="Licence History" rows={master.licenceHistory.map(x=>[`${x.country} · ${x.jurisdiction}`,x.licenceNumberRaw,`${x.class||"—"} · ${fmt(x.effectiveFrom)} → ${x.effectiveTo?fmt(x.effectiveTo):"Current"}`,x.verificationState||"Not Reviewed"])}/></CardContent></Card><Card><CardHeader><div className="flex justify-between"><CardTitle>Driving & Operating Qualification Facts</CardTitle><Button variant="outline" onClick={()=>openModal("qualification")}><Plus className="mr-2 size-4"/>Add Qualification Fact</Button></div></CardHeader><CardContent><p className="mb-4 text-sm text-muted-foreground">TES presents evidenced qualification facts and requirement state. It does not decide whether the company should assign, discipline, retrain or terminate a Driver.</p><Table heads={["Qualification","Applicable","Status","Effective","Expiry","Source"]} rows={qualifications.map(q=>[q.title,q.applicable,q.status,fmt(q.effectiveDate),fmt(q.expiryDate),q.sourceType||"—"])}/></CardContent></Card><Card><CardHeader><div className="flex justify-between"><CardTitle>Commercial Driving Experience</CardTitle><Button variant="outline" onClick={()=>openModal("experience")}><Plus className="mr-2 size-4"/>Add Experience Fact</Button></div></CardHeader><CardContent><Table heads={["Category","Declared","Supported","Source Records","Notes"]} rows={experience.map(e=>[e.category,e.declaredYears??"—",e.supportedYears??"—",e.sourceRecordIds?.join(", ")||"—",e.notes||"—"])}/></CardContent></Card></div>}

function Documents({apps,packages,taxForms,policies,evidence,openModal,onPreview}:{apps:any[];packages:any[];taxForms:any[];policies:any[];evidence:EvidenceRecord[];openModal:(x:string)=>void;onPreview:(x:EvidenceRecord)=>void}){return <div className="space-y-5"><Info text="Documents is structured data backed by evidence. The PDF is evidence for the record; it is not the record itself."/><DocSection title="Driver Application" desc="Historical hiring application facts: what the applicant declared at that time. Canonical Driver data is not silently overwritten." button="Add Application Record" onAdd={()=>openModal("application")} rows={apps.map(a=>[a.recordId,a.status,fmt(a.applicationDate),a.appliedRecordType||"—",a.operatingRegion||"—",`${a.employmentHistory?.length||0} employment entries`])}/><DocSection title="Hiring Package" desc="Structured acknowledgement/completion fields backed by the signed hiring package." button="Add Hiring Package" onAdd={()=>openModal("hiring-package")} rows={packages.map(p=>[p.recordId,p.status,fmt(p.packageDate),yesNo(p.employmentAgreement?.employeeAcknowledged),yesNo(p.orientationAcknowledgement?.acknowledged),yesNo(p.companyVehicleAcknowledgement?.acknowledged)])}/><DocSection title="TD1 / Tax Onboarding" desc="Track applicability, version, completion and evidence only. Do not turn TES into payroll and do not expose unnecessary sensitive tax details." button="Add Tax Form" onAdd={()=>openModal("tax-form")} rows={taxForms.map(t=>[t.recordId,t.formType,t.taxYear||"—",t.jurisdiction||"—",t.status,fmt(t.signedDate)])}/><DocSection title="Custom Policy" desc="Configurable policy acknowledgements; expand later without hard-coding company policy content." button="Add Policy Acknowledgement" onAdd={()=>openModal("policy")} rows={policies.map(p=>[p.recordId,p.policyName,p.policyVersion||"—",p.status,yesNo(p.acknowledged),fmt(p.acknowledgedDate)])}/><Card><CardHeader><CardTitle>Source Evidence</CardTitle></CardHeader><CardContent><Table heads={["Evidence ID","Category","File","Verification","Action"]} rows={evidence.map(e=>[e.recordId,e.category,e.fileName,e.verificationState,<Button key={e.id} size="sm" variant="outline" disabled={!e.dataUrl} onClick={()=>onPreview(e)}>View</Button>])}/></CardContent></Card></div>}
function Screening({screenings,medical,tests,openModal}:{screenings:any[];medical:any[];tests:any[];openModal:(x:string)=>void}){return <div className="space-y-5"><Info text="Screening records show what was checked and what the source/result states. TES does not make hiring or disciplinary decisions."/><DocSection title="Screenings" desc="Employment History Verification, Clearinghouse Query, PSP, Road Test, Criminal / Background Screening, Periodic Driver Review, and future Custom Screening." button="Add Screening" onAdd={()=>openModal("screening")} rows={screenings.map(x=>[x.recordId,x.type,fmt(x.recordDate),x.status,x.result||"—",x.provider||"—"])}/><DocSection title="Medical Qualification" desc="Current and historical commercial-driver medical qualification records. New records never overwrite history." button="Add Medical Record" onAdd={()=>openModal("medical")} rows={medical.map(x=>[x.recordId,fmt(x.recordDate),x.qualificationStatus,fmt(x.expirationDate),x.verificationState,x.examiner||"—"])}/><DocSection title="Drug & Alcohol Testing" desc="Restricted compliance records. Test facts remain distinct from training/policy acknowledgements." button="Add Test Record" onAdd={()=>openModal("drug-test")} rows={tests.map(x=>[x.recordId,x.testType,fmt(x.testDate),x.complianceStatus,x.resultStatus||"—",x.relatedEventId||"—"])}/></div>}
function Training({records,openModal}:{records:any[];openModal:(x:string)=>void}){const current=records.filter(r=>r.recordStatus==="Completed"&&(!r.expirationDate||r.expirationDate>=nowDate())).length,overdue=records.filter(r=>r.dueDate&&r.dueDate<nowDate()&&r.recordStatus!=="Completed").length;return <div className="space-y-5"><div className="grid gap-4 md:grid-cols-3"><Mini title="Training Records" value={records.length}/><Mini title="Current Completions" value={current}/><Mini title="Past Due Assignments" value={overdue}/></div><Card><CardHeader><div className="flex justify-between"><div><CardTitle>Training History</CardTitle><p className="mt-1 text-sm text-muted-foreground">Assignment/completion is one lifecycle; refresher creates a new linked Training Record.</p></div><Button onClick={()=>openModal("training")}><Plus className="mr-2 size-4"/>Add Training</Button></div></CardHeader><CardContent><Table heads={["Record ID","Course","Type","Status","Completed","Expiry","Provider"]} rows={records.map(r=>[r.recordId,r.course,r.trainingType,r.recordStatus,fmt(r.completionDate),fmt(r.expirationDate),r.provider||"—"])}/></CardContent></Card></div>}
function Performance({hos,violations,events,openModal}:{hos:any[];violations:any[];events:any[];openModal:(x:string)=>void}){const last30=hos.filter(x=>new Date(x.date)>=new Date(Date.now()-30*86400000)),mins=(k:string)=>last30.reduce((a,x)=>a+(Number(x[k])||0),0);return <div className="space-y-5"><Info text="TES presents facts, source records, calculations, patterns and company-recorded determinations. The carrier—not TES—decides discipline, retraining, assignment, suspension or termination."/><div className="grid gap-4 md:grid-cols-5"><Mini title="Driving · 30d" value={`${Math.round(mins("drivingMinutes")/60)}h`}/><Mini title="On Duty · 30d" value={`${Math.round(mins("onDutyMinutes")/60)}h`}/><Mini title="Potential HOS" value={violations.filter(v=>v.detectionStatus==="Potential"||v.detectionStatus==="Under Review").length}/><Mini title="Confirmed HOS" value={violations.filter(v=>v.detectionStatus==="Confirmed").length}/><Mini title="Linked Events" value={events.length}/></div><Card><CardHeader><div className="flex justify-between"><div><CardTitle>Hours of Service</CardTitle><p className="mt-1 text-sm text-muted-foreground">Source facts, rule profile, calculated conditions and company review remain separate.</p></div><div className="flex gap-2"><Button variant="outline" onClick={()=>openModal("hos-summary")}>Add HOS Summary</Button><Button onClick={()=>openModal("hos-violation")}>Add HOS Condition</Button></div></div></CardHeader><CardContent className="space-y-5"><Table heads={["Date","Driving","On Duty","Rule Profile","Potential","Confirmed","Source"]} rows={hos.map(x=>[fmt(x.date),`${Math.round((x.drivingMinutes||0)/60*10)/10}h`,`${Math.round((x.onDutyMinutes||0)/60*10)/10}h`,x.ruleProfile||"—",x.potentialViolationCount??0,x.confirmedViolationCount??0,x.source||"—"])}/><h4 className="font-semibold">HOS Conditions / Violations</h4><Table heads={["Record ID","Type","Detected","Duration","Status","Company Determination"]} rows={violations.map(v=>[v.recordId,v.violationType,fmt(v.detectedAt),v.durationMinutes?`${v.durationMinutes} min`:"—",v.detectionStatus,v.companyDetermination||"Not recorded"])}/></CardContent></Card><Card><CardHeader><div className="flex justify-between"><div><CardTitle>Record of Events</CardTitle><p className="mt-1 text-sm text-muted-foreground">Linked view of canonical portal-wide events; do not duplicate the underlying event.</p></div><Button variant="outline" onClick={()=>openModal("event-link")}>Link Event</Button></div></CardHeader><CardContent><Table heads={["Event ID","Category","Date","Title","Status","Vehicle","Company Determination"]} rows={events.map(e=>[e.eventId,e.eventCategory,fmt(e.eventDate),e.title,e.status||"—",e.vehicleId||"—",e.companyDetermination||"Not recorded"])}/></CardContent></Card></div>}

function RecordModal({kind,companyId,driverId,relationshipId,store,onClose,onSaved}:{kind:string;companyId:string;driverId:string;relationshipId:string;store:any;onClose:()=>void;onSaved:()=>void}){const [v,setV]=useState<Record<string,any>>({date:nowDate(),status:"Current",country:"Canada",verification:"Not Reviewed",recordType:"Employee",region:"Cross-Border"}),[err,setErr]=useState("");const set=(k:string,x:any)=>setV(s=>({...s,[k]:x}));const save=async()=>{setErr("");try{if(kind==="licence"){addLicence(companyId,driverId,{licenceNumberRaw:v.number||"",jurisdiction:v.jurisdiction||"",country:v.country||"Canada",documentType:v.documentType,class:v.class,endorsements:(v.endorsements||"").split(",").map((x:string)=>x.trim()).filter(Boolean),restrictions:(v.restrictions||"").split(",").map((x:string)=>x.trim()).filter(Boolean),airBrake:v.airBrake,issueDate:v.issueDate,expiryDate:v.expiryDate,effectiveFrom:v.effectiveFrom||v.date,verificationState:v.verification as VerificationState});recordAuditEvent({companyId,entityType:"Driver",entityId:driverId,action:"UPDATE",details:"Added Driver licence history record."});onSaved();return}let next=loadCompanyDriverStore(companyId);const base={companyId,driverMasterId:driverId,relationshipId};if(kind==="application"){const rec:any=createRecord(companyId,"APP",next.applications||[],{...base,status:v.status||"Draft",applicationDate:v.date,appliedRecordType:v.recordType,operatingRegion:v.region,personal:{phone:v.phone,email:v.email,addresses:[]},workAuthorization:{citizenshipOrAuthorization:v.workAuth,canTravelUS:v.usTravel},licenceDeclarations:[],experience:[],collisions:[],citations:[],employmentHistory:[],declarations:{},consents:[],evidenceIds:[]});next.applications=[...(next.applications||[]),rec]}
 else if(kind==="hiring-package"){const rec:any=createRecord(companyId,"HPR",next.hiringPackages||[],{...base,packageDate:v.date,status:v.status||"Draft",employeeInformation:{phone:v.phone,email:v.email,address:v.address,city:v.city,stateProvince:v.state,postalZip:v.postal,country:v.country,emergencyContactName:v.emergencyName,emergencyContactRelationship:v.emergencyRelationship,emergencyContactPhone:v.emergencyPhone,emergencyContactEmail:v.emergencyEmail,medicalConditionsOrAllergiesDeclared:v.medicalDeclaration||"Not Answered"},employmentAgreement:{agreementDate:v.agreementDate,employerLegalName:v.employer,governingJurisdiction:v.governing,employeeAcknowledged:v.employmentAck===true,signedDate:v.employmentSigned},orientationAcknowledgement:{healthSafetyOrientation:v.orientation===true,codeOfConduct:v.code===true,harassmentViolencePrevention:v.harassment===true,hazardAssessment:v.hazard===true,alcoholDrugPolicy:v.alcoholPolicy===true,incidentReporting:v.incident===true,vehicleInspection:v.inspection===true,fireEmergency:v.fire===true,ppe:v.ppe===true,whmisHazardCommunication:v.whmis===true,acknowledged:v.orientationAck===true,orientationDate:v.orientationDate},companyVehicleAcknowledgement:{driverLicencePolicy:v.dlPolicy===true,medicalConditionReportingPolicy:v.medPolicy===true,weatherConditions:v.weather===true,fuelCards:v.fuel===true,vehicleInspection:v.vehicleInspection===true,hosEld:v.hos===true,cargoSecurement:v.cargo===true,defensiveDriving:v.defensive===true,billOfLadingWaybills:v.bol===true,seatBelt:v.seatbelt===true,distractedDriving:v.distracted===true,speedLimits:v.speed===true,followingDistance:v.following===true,weightsDimensions:v.weights===true,dangerousGoods:v.dg===true,trianglesWarningDevices:v.triangles===true,daytimeRunningLights:v.drl===true,trainingAcknowledgement:v.trainingAck===true,acknowledged:v.vehicleAck===true},substanceTestingConsent:{consentStatus:v.substanceConsent||"Not Recorded",signedDate:v.substanceDate},driverAbstractConsent:{consentStatus:v.abstractConsent||"Not Recorded",signedDate:v.abstractDate},evidenceIds:[]});next.hiringPackages=[...(next.hiringPackages||[]),rec]}
 else {const map:any={"qualification":["qualifications","QLF"],"experience":["experience","EXP"],"screening":["screenings","SCR"],"medical":["medicalRecords","MED"],"drug-test":["drugAlcoholRecords","DAT"],"training":["trainingRecords","TRN"],"hos-summary":["hosSummaries","HOS"],"hos-violation":["hosViolations","HOSV"],"event-link":["eventLinks","EVL"],"tax-form":["taxForms","TAXD"],"policy":["customPolicies","POL"]};const [collection,code]=map[kind]||[];if(!collection)throw new Error("Unsupported record type.");const data:any={...base,...v};delete data.file;const rec:any=createRecord(companyId,code,(next as any)[collection]||[],normalizeByKind(kind,data));(next as any)[collection]=[...((next as any)[collection]||[]),rec]}
 if(v.file instanceof File){const dataUrl=await fileToDataUrl(v.file);const collections=[...(next.applications||[]),...(next.hiringPackages||[]),...(next.taxForms||[]),...(next.customPolicies||[]),...(next.screenings||[]),...(next.medicalRecords||[]),...(next.drugAlcoholRecords||[]),...(next.trainingRecords||[])];const target=collections[collections.length-1];const ev:any={id:makeInternalId("EVD"),recordId:allocateSubRecordId(companyId,"EVD",next.evidence||[]),category:v.fileCategory||kind,fileName:v.file.name,mimeType:v.file.type||"application/octet-stream",dataUrl,source:"Upload",verificationState:"Not Reviewed",createdAt:new Date().toISOString(),linkedRecordId:target?.id};next.evidence=[...(next.evidence||[]),ev];if(target?.evidenceIds)target.evidenceIds.push(ev.id)}saveCompanyDriverStore(next);recordAuditEvent({companyId,entityType:"Driver",entityId:driverId,action:"CREATE",details:`Added ${kind} record to Driver ${driverId}.`});onSaved()}catch(e){setErr(e instanceof Error?e.message:"Unable to save record.")}}
 return <div className="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-black/60 p-4 md:p-8"><div className="w-full max-w-4xl rounded-xl bg-background shadow-2xl"><div className="flex items-center justify-between border-b p-5"><div><h2 className="text-xl font-semibold">{title(kind)}</h2><p className="text-sm text-muted-foreground">Structured record · source evidence can be attached</p></div><Button variant="ghost" size="icon" onClick={onClose}><X className="size-4"/></Button></div><div className="space-y-5 p-5">{fields(kind,v,set)}<div className="rounded-lg border bg-muted/20 p-4"><Label>Source Evidence</Label><Input className="mt-2" type="file" accept="image/*,.pdf" onChange={e=>set("file",e.target.files?.[0]||null)}/><p className="mt-2 text-xs text-muted-foreground">Evidence supports the structured record. Filled information in a reference template is never copied automatically.</p></div>{err&&<div className="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800">{err}</div>}<div className="flex justify-end gap-2 border-t pt-4"><Button variant="outline" onClick={onClose}>Cancel</Button><Button onClick={save}>Save Record</Button></div></div></div></div>}

function normalizeByKind(k:string,d:any){if(k==="qualification")return {...d,type:d.type||"Operating Qualification",title:d.title||"Qualification",applicable:d.applicable||"Unknown",status:d.status||"Under Review",effectiveDate:d.date,expiryDate:d.expiryDate,sourceType:d.sourceType,sourceRecordId:d.sourceRecordId,notes:d.notes};if(k==="experience")return {...d,category:d.category||"Commercial Driving",declaredYears:Number(d.declaredYears)||undefined,supportedYears:Number(d.supportedYears)||undefined,sourceRecordIds:(d.sourceRecordIds||"").split(",").map((x:string)=>x.trim()).filter(Boolean),notes:d.notes};if(k==="screening")return {...d,type:d.type||"Employment History Verification",recordDate:d.date,status:d.status||"Under Review",result:d.result,dueDate:d.dueDate,expiryDate:d.expiryDate,provider:d.provider,notes:d.notes,evidenceIds:[]};if(k==="medical")return {...d,recordDate:d.date,regime:d.regime,examiner:d.examiner,examinerRegistryNumber:d.examinerRegistryNumber,qualificationStatus:d.qualificationStatus||"Pending",effectiveDate:d.effectiveDate,expirationDate:d.expiryDate,limitations:d.limitations,verificationState:d.verification||"Not Reviewed",evidenceIds:[]};if(k==="drug-test")return {...d,testType:d.testType||"Pre-Employment",testDate:d.date,complianceStatus:d.complianceStatus||"Under Review",resultStatus:d.resultStatus,followUpRequired:d.followUpRequired===true,relatedEventId:d.relatedEventId,evidenceIds:[]};if(k==="training")return {...d,course:d.course||"Training",trainingType:d.trainingType||"Initial",recordStatus:d.recordStatus||"Completed",assessmentResult:d.assessmentResult||"Not Required",assignedDate:d.assignedDate,dueDate:d.dueDate,completionDate:d.date,provider:d.provider,instructor:d.instructor,deliveryMethod:d.deliveryMethod,duration:d.duration,certificateNumber:d.certificateNumber,issueDate:d.issueDate,expirationDate:d.expiryDate,nextDueDate:d.nextDueDate,evidenceIds:[]};if(k==="hos-summary")return {...d,date:d.date,drivingMinutes:Number(d.drivingMinutes)||0,onDutyMinutes:Number(d.onDutyMinutes)||0,offDutyMinutes:Number(d.offDutyMinutes)||0,sleeperMinutes:Number(d.sleeperMinutes)||0,potentialViolationCount:Number(d.potentialViolationCount)||0,confirmedViolationCount:Number(d.confirmedViolationCount)||0,unassignedDrivingMinutes:Number(d.unassignedDrivingMinutes)||0,uncertifiedLogCount:Number(d.uncertifiedLogCount)||0,ruleProfile:d.ruleProfile,source:d.source};if(k==="hos-violation")return {...d,violationType:d.violationType||"HOS condition",detectedAt:d.date,durationMinutes:Number(d.durationMinutes)||undefined,ruleProfile:d.ruleProfile,vehicleId:d.vehicleId,tripId:d.tripId,location:d.location,detectionStatus:d.detectionStatus||"Potential",companyDetermination:d.companyDetermination,notes:d.notes};if(k==="event-link")return {...d,eventId:d.eventId||"",eventCategory:d.eventCategory||"Performance Event",eventDate:d.date,title:d.title||"Linked Event",status:d.status,vehicleId:d.vehicleId,tripId:d.tripId,location:d.location,summary:d.summary,companyDetermination:d.companyDetermination};if(k==="tax-form")return {...d,formType:d.formType||"TD1 Federal",taxYear:d.taxYear,jurisdiction:d.jurisdiction,formVersion:d.formVersion,completedDate:d.completedDate,signedDate:d.date,status:d.status||"Received",evidenceIds:[]};if(k==="policy")return {...d,policyName:d.policyName||"Custom Policy",policyVersion:d.policyVersion,effectiveDate:d.effectiveDate,acknowledged:d.acknowledged===true,acknowledgedDate:d.date,status:d.status||"Current",evidenceIds:[]};return d}
function fields(k:string,v:any,set:(k:string,v:any)=>void){const common=(names:Array<[string,string,string?]>)=><Grid>{names.map(([key,label,type])=><F key={key} l={label} t={type||"text"} v={v[key]??""} s={x=>set(key,x)}/>)}</Grid>;if(k==="licence")return <><Grid><S l="Country" v={v.country||"Canada"} s={x=>set("country",x)} o={["Canada","United States"]}/><F l="Jurisdiction *" v={v.jurisdiction||""} s={x=>set("jurisdiction",x)}/><F l="Licence Number *" v={v.number||""} s={x=>set("number",x)}/><F l="Document Type" v={v.documentType||"Commercial Driver Licence"} s={x=>set("documentType",x)}/><F l="Class" v={v.class||""} s={x=>set("class",x)}/><F l="Endorsements (comma-separated)" v={v.endorsements||""} s={x=>set("endorsements",x)}/><F l="Restrictions (comma-separated)" v={v.restrictions||""} s={x=>set("restrictions",x)}/><F l="Air Brake" v={v.airBrake||""} s={x=>set("airBrake",x)}/><F l="Issue Date" t="date" v={v.issueDate||""} s={x=>set("issueDate",x)}/><F l="Expiry Date" t="date" v={v.expiryDate||""} s={x=>set("expiryDate",x)}/><F l="Effective From *" t="date" v={v.effectiveFrom||v.date} s={x=>set("effectiveFrom",x)}/><S l="Verification" v={v.verification||"Not Reviewed"} s={x=>set("verification",x)} o={["Not Reviewed","Under Review","Source Matched","Difference Present","Externally Verified"]}/></Grid><Info text="A format mismatch is a review condition, not proof that the licence is invalid. Documentary/OCR/manual/authority values must never silently overwrite one another."/></>;if(k==="application")return <><Grid><F l="Application Date" t="date" v={v.date} s={x=>set("date",x)}/><S l="Status" v={v.status||"Draft"} s={x=>set("status",x)} o={["Draft","Invited","Started","Submitted","Under Review","Additional Information Requested","Approved","Rejected","Withdrawn","Expired","Invitation Cancelled"]}/><S l="Applied Record Type" v={v.recordType||"Employee"} s={x=>set("recordType",x)} o={RT}/><S l="Operating Region" v={v.region||"Cross-Border"} s={x=>set("region",x)} o={RG}/><F l="Phone" v={v.phone||""} s={x=>set("phone",x)}/><F l="Email" v={v.email||""} s={x=>set("email",x)}/><F l="Work Authorization / Citizenship Declaration" v={v.workAuth||""} s={x=>set("workAuth",x)}/><S l="Can Travel to U.S." v={v.usTravel||""} s={x=>set("usTravel",x)} o={["","Yes","No","Not Applicable"]}/></Grid><Info text="The Application record is a historical snapshot of what the applicant declared. Address history, licence history, experience, collisions, citations, employment/activity history, declarations and versioned consents belong to this Application record and can be expanded without overwriting Driver Master facts."/></>;if(k==="hiring-package")return <><Info text="Fields below are derived from the blank structure of the supplied 19-page hiring package. No pre-filled person/company values from the sample are retained."/><Grid><F l="Package Date" t="date" v={v.date} s={x=>set("date",x)}/><S l="Status" v={v.status||"Draft"} s={x=>set("status",x)} o={["Draft","Issued","Partially Completed","Completed","Under Review","Historical"]}/><F l="Phone" v={v.phone||""} s={x=>set("phone",x)}/><F l="Email" v={v.email||""} s={x=>set("email",x)}/><F l="Address" v={v.address||""} s={x=>set("address",x)}/><F l="City" v={v.city||""} s={x=>set("city",x)}/><F l="State / Province" v={v.state||""} s={x=>set("state",x)}/><F l="Postal / ZIP" v={v.postal||""} s={x=>set("postal",x)}/><F l="Emergency Contact Name" v={v.emergencyName||""} s={x=>set("emergencyName",x)}/><F l="Emergency Contact Relationship" v={v.emergencyRelationship||""} s={x=>set("emergencyRelationship",x)}/><F l="Emergency Contact Phone" v={v.emergencyPhone||""} s={x=>set("emergencyPhone",x)}/><F l="Emergency Contact Email" v={v.emergencyEmail||""} s={x=>set("emergencyEmail",x)}/><S l="Medical Conditions / Allergies Declared?" v={v.medicalDeclaration||"Not Answered"} s={x=>set("medicalDeclaration",x)} o={["Not Answered","Yes","No"]}/><F l="Employment Agreement Date" t="date" v={v.agreementDate||""} s={x=>