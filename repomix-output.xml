export default function DriverPage({params}:{params:Promise<{id:string;driverId:string}>}){
 const {id:companyId,driverId}=use(params),company=getCompany(companyId)
 const [master,setMaster]=useState<DriverMaster|null>(null),[rel,setRel]=useState<CompanyDriverRelationship|null>(null),[store,setStore]=useState(()=>loadCompanyDriverStore(companyId)),[tab,setTab]=useState<(typeof TABS)[number]>("Profile"),[edit,setEdit]=useState(false),[draft,setDraft]=useState<Record<string,string>>({}),[error,setError]=useState(""),[modal,setModal]=useState<string|null>(null),[preview,setPreview]=useState<EvidenceRecord|null>(null)
 const hydrate=()=>{const m=loadDriverMasterStore().drivers.find(d=>d.id===driverId)||null,r=loadCompanyDriverStore(companyId).relationships.find(x=>x.driverMasterId===driverId&&!x.archive.isArchived)||null;setMaster(m);setRel(r);setStore(loadCompanyDriverStore(companyId));if(m&&r){const a=currentAddress(m);setDraft({first:m.identity.legalFirstName,middle:m.identity.legalMiddleName||"",last:m.identity.legalLastName,preferred:m.identity.preferredName||"",dob:m.identity.dateOfBirth,recordType:r.recordType,region:r.operatingRegion,status:r.driverStatus,start:r.startDate,end:r.endDate||"",address1:a?.addressLine1||"",address2:a?.addressLine2||"",city:a?.city||"",state:a?.stateProvince||"",postal:a?.postalZip||"",country:a?.country||"Canada",addressEffective:a?.effectiveFrom||nowDate()})}}
 useEffect(()=>hydrate(),[companyId,driverId])
 const mine=<T extends {driverMasterId:string}>(xs?:T[])=> (xs||[]).filter(x=>x.driverMasterId===driverId)
 const apps=mine(store.applications),packages=mine(store.hiringPackages),evidence=(store.evidence||[]).filter(e=>!e.linkedRecordId||[...apps,...packages,...(store.screenings||[]),...(store.medicalRecords||[]),...(store.drugAlcoholRecords||[]),...(store.trainingRecords||[])].some((r:any)=>r.id===e.linkedRecordId)),quals=(store.qualifications||[]).filter((x:any)=>x.driverMasterId===driverId),experience=(store.experience||[]).filter((x:any)=>x.driverMasterId===driverId),screenings=(store.screenings||[]).filter((x:any)=>x.driverMasterId===driverId),medical=(store.medicalRecords||[]).filter((x:any)=>x.driverMasterId===driverId),tests=(store.drugAlcoholRecords||[]).filter((x:any)=>x.driverMasterId===driverId),training=(store.trainingRecords||[]).filter((x:any)=>x.driverMasterId===driverId),hos=(store.hosSummaries||[]).filter((x:any)=>x.driverMasterId===driverId),violations=(store.hosViolations||[]).filter((x:any)=>x.driverMasterId===driverId),events=(store.eventLinks||[]).filter((x:any)=>x.driverMasterId===driverId)
 if(!company||!master||!rel)return <div className="space-y-4"><Link href={`/companies/${companyId}/drivers`} className="inline-flex items-center gap-2 text-sm text-muted-foreground"><ArrowLeft className="size-4"/>Back to Drivers</Link><Card><CardContent className="p-8">Driver Master or active company Driver relationship not found.</CardContent></Card></div>
 const licence=currentLicence(master),address=currentAddress(master),recordId=displayCompanyDriverRecordId(companyId,rel)
 const saveProfile=()=>{setError("");try{updateDriverProfileAtomic(companyId,driverId,{identity:{legalFirstName:draft.first,legalMiddleName:draft.middle||undefined,legalLastName:draft.last,preferredName:draft.preferred||undefined,dateOfBirth:draft.dob},recordType:draft.recordType as RecordType,operatingRegion:draft.region as OperatingRegion,driverStatus:draft.status as DriverStatus,relationshipStartDate:draft.start,relationshipEndDate:draft.end||undefined,address:{addressLine1:draft.address1,addressLine2:draft.address2||undefined,city:draft.city,stateProvince:draft.state,postalZip:draft.postal,country:draft.country as Country,effectiveFrom:draft.addressEffective}});recordAuditEvent({companyId,entityType:"Driver",entityId:driverId,action:"UPDATE",details:`Updated Driver profile ${recordId}.`});setEdit(false);hydrate()}catch(e){setError(e instanceof Error?e.message:"Unable to save Driver profile.")}}
 return <div className="space-y-6">
