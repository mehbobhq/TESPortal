      <div className="md:col-span-3">
        <p className="text-sm font-medium">
          {
            record.insurerName
          }
        </p>

        <p className="mt-1 select-text font-mono text-[10px] text-muted-foreground">
          Policy{" "}
          {
            record.policyNumber
          }
        </p>
      </div>

      <div className="md:col-span-2">
        {record.coverage
          .slice(
            0,
            3
          )
          .map(
