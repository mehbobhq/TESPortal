            </CardDescription>
          </CardHeader>

          <CardContent className="grid gap-5 pt-6 sm:grid-cols-2 lg:grid-cols-3">
            <div className="space-y-2 lg:col-span-2">
              <Label htmlFor="companyName">
                Company Name *
              </Label>

              <Input
