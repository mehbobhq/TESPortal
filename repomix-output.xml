                onValueChange={setOpRegion}
              >
                <SelectTrigger className="border-primary/30">
                  <SelectValue />
                </SelectTrigger>

                <SelectContent>
                  <SelectItem value="Canada Only">
                    Canada Only
                  </SelectItem>

                  <SelectItem value="US Only">
                    US Only
                  </SelectItem>

                  <SelectItem value="Cross-Border">
                    Cross-Border
