function defaultJurisdictionFor(
  company:
    Company,

  category:
    AuthorityCategory
) {
  if (
    category ===
      "us_federal" ||
    category ===
      "operating_registration"
  ) {
    return JURISDICTIONS.find(
      (item) =>
        item.code ===
        "US-FED"
    )!
  }

  const state =
    normalizeText(
      company.regCorpState
    )

  return (
    JURISDICTIONS.find(
      (item) =>
        item.country ===
          "Canada" &&
        (
          normalizeText(
            item.code
          ) ===
            state ||
          normalizeText(
            item.label
          ) ===
            state
        )
    ) ||
    JURISDICTIONS.find(
      (item) =>
        item.code ===
        "CA-FED"
    )!
  )
}

