  const [inspectionForm, setInspectionForm] = useState<{
    inspectionLevel: RoadsideInspectionDetails["inspectionLevel"] | "";
    reportNumber: string;
    agency: string;
    result: RoadsideInspectionDetails["result"] | "";
    driverViolationsCount: number;
