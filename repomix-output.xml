/* =========================================================
   FILE READER
========================================================= */

function readFileAsDataUrl(
  file: File
): Promise<string> {
  return new Promise(
    (
      resolve,
      reject
    ) => {
      const reader =
        new FileReader()

      reader.onload =
        () =>
          resolve(
            String(
              reader.result ||
                ""
            )
          )

      reader.onerror =
        reject

      reader.readAsDataURL(
        file
      )
    }
  )
}

