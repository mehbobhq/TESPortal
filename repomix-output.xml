  <div className="flex gap-1 overflow-x-auto rounded-lg border bg-muted/30 p-1">{TABS.map(t=><button key={t} onClick={()=>{setTab(t);setEdit(false)}} className={`whitespace-nowrap rounded-md px-4 py-2 text-sm font-medium ${tab===t?"bg-background shadow-sm":"text-muted-foreground hover:text-foreground"}`}>{t}</button>)}</div>
