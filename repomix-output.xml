                </SelectContent>
              </Select>
            </div>
          </CardContent>
        </Card>

        {/* ===================================================
            SECTION 2 — CORE INFORMATION
        =================================================== */}

        <Card>
          <CardHeader className="border-b bg-muted/20">
            <CardTitle className="flex items-center gap-2 text-sm">
