                    <p className="mt-3 text-sm font-medium">
                      No audit or intervention records found.
                    </p>
                  </div>
                ) : (
                  <div className="divide-y">
                    {filteredAudits.map(
                      (
                        record
                      ) => (
                        <AuditRow
