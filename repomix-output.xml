      return
    }

    setContacts((current) =>
      current.map((contact) => {
        if (
          contact.id !==
          selectedContact.id
        ) {
          return contact
        }

        return appendEvent(
          {
            ...contact,
            notes:
              noteDraft.trim(),
          },
          "NOTE_ADDED",
          "Internal contact note updated."
        )
      })
    )
  }

