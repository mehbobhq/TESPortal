"use client";

import React, { useState } from "react";
import { Copy, Check, ExternalLink, ShieldCheck } from "lucide-react";

export interface ReadOnlyFieldProps {
  label: string;
  value?: string | number | null;
  copyable?: boolean;
  mono?: boolean;
